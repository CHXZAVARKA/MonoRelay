+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withTimeoutOrNull
+
+class MonoRelayActivity : ComponentActivity() {
+    private data class Address(val ip: String, val port: Int)
+
+    private val preferences by lazy { getSharedPreferences("mono_relay", Context.MODE_PRIVATE) }
+    private val presets by lazy { MonoRelayPreset.read(this) }
+    private var selected by mutableStateOf(AUTO_QUALITY)
+    private var address by mutableStateOf("")
+    private var showAddress by mutableStateOf(false)
+    private var search: Job? = null
+    private var searching by mutableStateOf(false)
+    private var failure by mutableStateOf<String?>(null)
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        selected = preferences.getString("preset", AUTO_QUALITY) ?: AUTO_QUALITY
+        address = preferences.getString("address", "") ?: ""
+        setContent {
+            val palette = if (isSystemInDarkTheme()) darkColorScheme(primary = Color(0xFF8DBBFF))
+                else lightColorScheme(primary = Color(0xFF0969DA))
+            MaterialTheme(colorScheme = palette) {
+                Surface(Modifier.fillMaxSize()) { Home() }
+            }
+        }
+        if (savedInstanceState == null) connect()
+    }
+
+    @Composable
+    private fun Home() {
+        Column(
+            Modifier.fillMaxSize().safeDrawingPadding().verticalScroll(rememberScrollState()).padding(24.dp),
+            verticalArrangement = Arrangement.spacedBy(18.dp),
+        ) {
+            Row(horizontalArrangement = Arrangement.spacedBy(12.dp), verticalAlignment = Alignment.CenterVertically) {
+                Icon(Icons.Outlined.Tv, null, Modifier.size(28.dp), tint = MaterialTheme.colorScheme.primary)
+                Text("Трансляция Quest", style = MaterialTheme.typography.headlineSmall, fontWeight = FontWeight.Bold)
+            }
+            HorizontalDivider()
+            Row(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
+                if (searching) CircularProgressIndicator(Modifier.size(18.dp), strokeWidth = 2.dp)
+                else Icon(Icons.Outlined.Wifi, null, Modifier.size(18.dp), tint = MaterialTheme.colorScheme.onSurfaceVariant)
+                Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                    val error = failure
+                    Text(when {
+                        searching -> "Ищем Quest в локальной сети…"
+                        error != null -> "Не удалось подключиться"
+                        else -> "Готово к подключению"
+                    }, style = MaterialTheme.typography.titleSmall)
+                    Text(when {
+                        searching -> "Проверяем подключение и сохранённый адрес."
+                        error != null -> error
+                        else -> "Подключи телефон и Quest к одной сети."
+                    }, style = MaterialTheme.typography.bodyMedium, color = MaterialTheme.colorScheme.onSurfaceVariant)
+                }
+            }
+            Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {
+                val choices = listOf(AUTO_QUALITY to "Авто") + presets.map { it.id to it.label }
+                BoxWithConstraints(Modifier.fillMaxWidth()) {
+                    val rows = if (maxWidth < 306.dp) choices.chunked(2) else listOf(choices)
+                    Column(verticalArrangement = Arrangement.spacedBy(4.dp)) {
+                        rows.forEach { QualityRow(it) }
+                    }
+                }
+                Text(presets.firstOrNull { it.id == selected }?.detail ?: "Сам подберёт качество",
+                    style = MaterialTheme.typography.bodySmall, color = MaterialTheme.colorScheme.onSurfaceVariant)
+            }
+            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
+                OutlinedButton(onClick = { showAddress = true }, enabled = !searching) { Text("Ввести IP…") }
+                Button(onClick = { if (searching) cancelSearch() else connect() }) {
+                    Text(if (searching) "Отменить" else "Подключить")
+                }
+            }
+        }
+        if (showAddress) AddressDialog()
+    }
+
+    @Composable
+    private fun QualityRow(choices: List<Pair<String, String>>) {
+        SingleChoiceSegmentedButtonRow(Modifier.fillMaxWidth()) {
+            choices.forEachIndexed { index, (id, label) ->
+                SegmentedButton(
+                    selected = selected == id,
+                    onClick = {
+                        selected = id
+                        preferences.edit().putString("preset", id).apply()
+                    },
+                    shape = SegmentedButtonDefaults.itemShape(index = index, count = choices.size),
+                    icon = {},
+                    label = { Text(label, maxLines = 1) },
+                )
+            }
+        }
+    }
+
+    @Composable
+    private fun AddressDialog() {
+        val endpoint = parse(address)
+        AlertDialog(
+            onDismissRequest = { showAddress = false },
+            title = { Text("Подключиться по адресу") },
+            text = {
+                Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                    Text("Возьми IP из настроек Wi-Fi в очках. Добавь порт, если он отличается от 5555.")
+                    OutlinedTextField(address, { address = it }, label = { Text("IP Quest") },
+                        placeholder = { Text("192.168.1.42:5555") }, singleLine = true,
+                        isError = address.isNotBlank() && endpoint == null,
+                        keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Uri, imeAction = ImeAction.Go),
+                        keyboardActions = KeyboardActions(onGo = { endpoint?.let { connectManual(it) } }),
+                        modifier = Modifier.fillMaxWidth())
+                    TextButton(onClick = {
+                        showAddress = false
+                        startActivity(Intent(this@MonoRelayActivity, MainActivity::class.java)
+                            .putExtra(MainActivity.EXTRA_OPEN_PAIRING, true))
+                    }) { Text("Шлем показывает код сопряжения") }
+                }
+            },
+            dismissButton = { TextButton(onClick = { showAddress = false }) { Text("Отмена") } },
+            confirmButton = {
+                Button(enabled = endpoint != null, onClick = { endpoint?.let { connectManual(it) } }) {
+                    Text("Подключить")
+                }
+            },
+        )
+    }
+
+    private fun connectManual(endpoint: Address) {
+        showAddress = false
+        connect(endpoint)
+    }
+
+    private fun cancelSearch() {
+        search?.cancel()
+    }
+
+    private fun connect(manual: Address? = null) {
+        if (searching) return
+        searching = true
+        failure = null
+        search = lifecycleScope.launch {
+            try {
+                val serial = preferences.getString("serial", null)
+                val endpoint = manual ?: findService(serial)?.let { resolve(it) }
+                    ?: preferences.getString("address", null)?.let { parse(it) }
+                if (endpoint == null) {
+                    failure = "Проверь Wi-Fi и отладку на шлеме. Если Quest не находится, введи IP вручную."
+                    return@launch
+                }
+                address = "${endpoint.ip}:${endpoint.port}"
+                val options = "audio=playback&audioDup=true"
+                startActivity(MirrorActivity.newIntent(this@MonoRelayActivity, endpoint.ip, endpoint.port, linkOptions = options))
+            } finally {
+                searching = false
+                search = null
+            }
+        }
+    }
+
+    private fun parse(value: String): Address? {
+        val parts = value.trim().split(':')
+        if (parts.size !in 1..2) return null
+        val octets = parts[0].split('.').map { it.toIntOrNull() ?: return null }
+        if (octets.size != 4 || octets.any { it !in 0..255 }) return null
+        val privateNetwork = octets[0] == 10 || octets[0] == 172 && octets[1] in 16..31 ||
+            octets[0] == 192 && octets[1] == 168 || octets[0] == 169 && octets[1] == 254
+        if (!privateNetwork) return null
+        val port = if (parts.size == 2) parts[1].toIntOrNull() ?: return null else 5555
+        return if (port in 1..65535) Address(octets.joinToString("."), port) else null
+    }
+
+    private suspend fun findService(serial: String?): NsdServiceInfo? {
+        val nsd = getSystemService(NsdManager::class.java) ?: return null
+        val services = callbackFlow {
+            val listener = object : NsdManager.DiscoveryListener {
+                override fun onDiscoveryStarted(type: String) = Unit
+                override fun onDiscoveryStopped(type: String) { close() }
+                override fun onStopDiscoveryFailed(type: String, code: Int) { close() }
+                override fun onStartDiscoveryFailed(type: String, code: Int) { close() }
+                override fun onServiceLost(info: NsdServiceInfo) { trySend(info to false) }
+                override fun onServiceFound(info: NsdServiceInfo) {
+                    if (info.serviceName.startsWith("adb-") &&
+                        (serial == null || info.serviceName == "adb-$serial")) trySend(info to true)
+                }
+            }
+            runCatching { nsd.discoverServices("_adb._tcp.", NsdManager.PROTOCOL_DNS_SD, listener) }
+                .onFailure { close() }
+            awaitClose { runCatching { nsd.stopServiceDiscovery(listener) } }
+        }
+        if (serial != null) {
+            return withTimeoutOrNull(1600) { services.firstOrNull { it.second }?.first }
+        }
+        // Without a saved serial, only suggest an address if discovery found one service.
+        val candidates = mutableMapOf<String, NsdServiceInfo>()
+        withTimeoutOrNull(1800) {
+            services.collect { (info, found) ->
+                if (found) candidates[info.serviceName] = info else candidates.remove(info.serviceName)
+            }
+        }
+        return candidates.values.singleOrNull()
+    }
+
+    @Suppress("DEPRECATION")
+    private suspend fun resolve(service: NsdServiceInfo): Address? = withTimeoutOrNull(1400) {
+        suspendCancellableCoroutine { continuation ->
+            val nsd = getSystemService(NsdManager::class.java)
+            if (nsd == null) { continuation.resume(null); return@suspendCancellableCoroutine }
+            val completed = AtomicBoolean(false)
+            fun finish(address: Address?) {
+                if (completed.compareAndSet(false, true)) continuation.resume(address)
+            }
+            continuation.invokeOnCancellation { completed.set(true) }
+            runCatching {
+                nsd.resolveService(service, object : NsdManager.ResolveListener {
+                    override fun onResolveFailed(info: NsdServiceInfo, code: Int) = finish(null)
+                    override fun onServiceResolved(info: NsdServiceInfo) {
+                        val ip = (info.host as? Inet4Address)?.hostAddress
+                        finish(ip?.let { parse("$it:${info.port}") })
+                    }
+                })
+            }.onFailure { finish(null) }
+        }
+    }
+}
