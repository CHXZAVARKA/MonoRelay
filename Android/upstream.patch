+private val RelayBlue = Color(0xFF0861D6)
+
+class MonoRelayActivity : ComponentActivity() {
+    private data class Address(val ip: String, val port: Int)
+
+    private val viewModel: MirrorViewModel by viewModels()
+    private val preferences by lazy { getSharedPreferences("mono_relay", Context.MODE_PRIVATE) }
+    private val presets by lazy { MonoRelayPreset.read(this) }
+    private val playbackSettings = MirrorSettings(
+        audioSource = AudioSource.PLAYBACK,
+        audioDup = true,
+        autoReconnect = true,
+        captureEdgeGestures = false,
+        clipboardAutosync = false,
+    )
+    private var adaptive = AdaptiveQuality()
+    private var selected by mutableStateOf(AUTO_QUALITY)
+    private var address by mutableStateOf("")
+    private var showAddress by mutableStateOf(false)
+    private var search: Job? = null
+    private var searching by mutableStateOf(false)
+    private var searchFailed by mutableStateOf(false)
+    private var resumeOnOpen = true
+    private val preset get() = presets.firstOrNull { it.id == selected } ?: presets[adaptive.index]
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        selected = preferences.getString("preset", AUTO_QUALITY) ?: AUTO_QUALITY
+        address = preferences.getString("address", "") ?: ""
+        resumeOnOpen = savedInstanceState?.getBoolean("resume_stream") ?: true
+        enableEdgeToEdge()
+        setContent {
+            val palette = if (isSystemInDarkTheme()) darkColorScheme(
+                primary = Color(0xFF90BEFF), surface = Color(0xFF181A20), surfaceVariant = Color(0xFF252932),
+                outlineVariant = Color(0xFF3B414D), onSurfaceVariant = Color(0xFFD1D7E3),
+            ) else lightColorScheme(
+                primary = RelayBlue, surface = Color(0xFFFCFCFD), surfaceVariant = Color(0xFFF1F4F9),
+                outlineVariant = Color(0xFFD9E0EA), onSurfaceVariant = Color(0xFF515C6B),
+            )
+            MaterialTheme(colorScheme = palette) {
+                Surface(Modifier.fillMaxSize()) { Home() }
+            }
+        }
+        watchQuality()
+    }
+
+    override fun onSaveInstanceState(outState: Bundle) {
+        outState.putBoolean("resume_stream", resumeOnOpen)
+        super.onSaveInstanceState(outState)
+    }
+
+    override fun onStart() {
+        super.onStart()
+        viewModel.onVisibilityChanged(true)
+        if (resumeOnOpen) connect()
+    }
+
+    override fun onStop() {
+        search?.cancel()
+        viewModel.onVisibilityChanged(false)
+        viewModel.disconnect()
+        super.onStop()
+    }
+
+    @Composable
+    private fun Home() {
+        val state by viewModel.state.collectAsState()
+        val checkup by viewModel.checkup.collectAsState()
+        val connected = state as? MirrorUiState.Connected
+        val connecting = state is MirrorUiState.Connecting
+        val immersive = connected != null
+        val active = searching || connecting || immersive
+        val failed = searchFailed || state is MirrorUiState.Failed
+        var menuVisible by remember(immersive) { mutableStateOf(false) }
+        BackHandler(enabled = active || showAddress) {
+            when {
+                menuVisible -> menuVisible = false
+                showAddress -> showAddress = false
+                else -> stopStream()
+            }
+        }
+        LaunchedEffect(active) {
+            val flag = WindowManager.LayoutParams.FLAG_KEEP_SCREEN_ON
+            if (active) window.addFlags(flag) else window.clearFlags(flag)
+        }
+        DisposableEffect(immersive) {
+            val controller = WindowCompat.getInsetsController(window, window.decorView)
+            if (immersive) {
+                controller.systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+                controller.hide(WindowInsetsCompat.Type.systemBars())
+            }
+            onDispose { if (immersive) controller.show(WindowInsetsCompat.Type.systemBars()) }
+        }
+
+        Box(Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
+            if (connecting || immersive) {
+                // Keep the decoder's surface in place from the connection handshake to fullscreen.
+                val videoSize = if (immersive) Modifier.fillMaxSize() else Modifier.size(1.dp)
+                Video(connected, videoSize)
+            }
+            if (immersive) {
+                Box(Modifier.matchParentSize().semantics { contentDescription = "Quest stream" }.clickable(
+                    indication = null, interactionSource = null,
+                    onClickLabel = if (menuVisible) "Hide stream controls" else "Show stream controls",
+                ) { menuVisible = !menuVisible })
+                if (menuVisible) {
+                    Surface(
+                        modifier = Modifier.align(Alignment.BottomCenter).safeDrawingPadding().padding(16.dp)
+                            .widthIn(max = 440.dp).fillMaxWidth(),
+                        shape = RoundedCornerShape(16.dp),
+                        border = BorderStroke(1.dp, MaterialTheme.colorScheme.outlineVariant),
+                        shadowElevation = 6.dp,
+                    ) {
+                        Column(Modifier.padding(12.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween,
+                                verticalAlignment = Alignment.CenterVertically) {
+                                ConnectionStatus(statusText(state, checkup), busy = false, streaming = true)
+                                TextButton(onClick = ::stopStream) { Text("Stop") }
+                            }
+                            Quality(available = true, compact = true)
+                        }
+                    }
+                }
+            } else {
+                Launcher(state, checkup, active = active, connecting = connecting, failed = failed)
+            }
+        }
+    }
+
+    @Composable
+    private fun Launcher(
+        state: MirrorUiState, checkup: ConnectionCheckup?, active: Boolean, connecting: Boolean, failed: Boolean,
+    ) {
+        val uriHandler = LocalUriHandler.current
+        Column(
+            Modifier.fillMaxSize().safeDrawingPadding().verticalScroll(rememberScrollState()).padding(24.dp),
+            horizontalAlignment = Alignment.CenterHorizontally,
+        ) {
+            Column(Modifier.widthIn(max = 420.dp).fillMaxWidth().padding(top = 16.dp, bottom = 16.dp),
+                horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.spacedBy(24.dp)) {
+                Column(horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                    Image(painterResource(R.drawable.ic_monorelay), contentDescription = null, modifier = Modifier.size(80.dp))
+                    Text("MonoRelay", fontSize = 34.sp, fontWeight = FontWeight.SemiBold,
+                        modifier = Modifier.semantics { heading() })
+                }
+                Column(horizontalAlignment = Alignment.CenterHorizontally) {
+                    ConnectionStatus(statusText(state, checkup), busy = searching || connecting, streaming = false)
+                    if (failed) {
+                        TextButton(onClick = {
+                            uriHandler.openUri("https://github.com/CHXZAVARKA/MonoRelay/blob/main/SETUP.md")
+                        }) { Text("Setup guide") }
+                    }
+                }
+                Quality(available = !connecting, compact = false)
+                HorizontalDivider(color = MaterialTheme.colorScheme.outlineVariant)
+                if (showAddress) {
+                    ManualAddress()
+                } else {
+                    Column(horizontalAlignment = Alignment.CenterHorizontally) {
+                        Button(
+                            onClick = { if (active) stopStream() else connect() },
+                            modifier = Modifier.fillMaxWidth().heightIn(min = 48.dp),
+                            shape = RoundedCornerShape(12.dp),
+                            colors = ButtonDefaults.buttonColors(containerColor = RelayBlue, contentColor = Color.White),
+                        ) { Text(if (active) "Stop" else if (failed) "Retry" else "Connect") }
+                        if (failed) TextButton(onClick = { showAddress = true }) { Text("Enter IP") }
+                    }
+                }
+            }
+        }
+    }
+
+    @Composable
+    private fun ConnectionStatus(text: String, busy: Boolean, streaming: Boolean) {
+        Row(horizontalArrangement = Arrangement.spacedBy(8.dp), verticalAlignment = Alignment.CenterVertically,
+            modifier = Modifier.semantics { liveRegion = LiveRegionMode.Polite }) {
+            if (busy) CircularProgressIndicator(Modifier.size(14.dp), strokeWidth = 2.dp)
+            else Box(Modifier.size(8.dp).background(
+                if (streaming) Color(0xFF25A462) else MaterialTheme.colorScheme.primary, CircleShape,
+            ))
+            Text(text, style = MaterialTheme.typography.bodyMedium, textAlign = TextAlign.Center)
+        }
+    }
+
+    private fun statusText(state: MirrorUiState, checkup: ConnectionCheckup?): String = when {
+        checkup?.failedStage == CheckupStage.AUTHORIZE -> "Approve debugging in the headset, then tap Retry."
+        checkup?.steps?.any {
+            it.stage == CheckupStage.AUTHORIZE && it.status == StageStatus.RUNNING
+        } == true -> "Confirm in the headset"
+        searching -> "Looking for Quest…"
+        state is MirrorUiState.Connected && checkup?.steps?.any {
+            it.stage == CheckupStage.MEDIA && it.status == StageStatus.PASSED
+        } == true -> "Streaming"
+        state is MirrorUiState.Connected -> "Waiting for video…"
+        state is MirrorUiState.Connecting -> "Connecting to Quest…"
+        searchFailed && !preferences.contains("serial") ->
+            "Connect Quest to a computer by USB and enable ADB over Wi-Fi."
+        searchFailed -> "Quest not found. Check Wi-Fi and ADB over Wi-Fi."
+        state is MirrorUiState.Failed -> "Could not connect to Quest"
+        else -> "Ready to connect"
+    }
+
+    @Composable
+    private fun Video(state: MirrorUiState.Connected?, modifier: Modifier) {
+        BoxWithConstraints(modifier.background(Color.Black), contentAlignment = Alignment.Center) {
+            val ratio = if (state != null && state.videoWidth > 0 && state.videoHeight > 0) {
+                state.videoWidth.toFloat() / state.videoHeight
+            } else 16f / 9f
+            val videoWidth = minOf(maxWidth, maxHeight * ratio)
+            AndroidView(
+                modifier = Modifier.width(videoWidth).aspectRatio(ratio),
+                factory = { context ->
+                    SurfaceView(context).apply {
+                        holder.addCallback(object : SurfaceHolder.Callback {
+                            override fun surfaceCreated(holder: SurfaceHolder) = viewModel.setSurface(holder.surface)
+                            override fun surfaceChanged(holder: SurfaceHolder, format: Int, width: Int, height: Int) = Unit
+                            override fun surfaceDestroyed(holder: SurfaceHolder) = viewModel.releaseSurface()
+                        })
+                    }
+                },
+            )
+        }
+    }
+
+    @Composable
+    private fun Quality(available: Boolean, compact: Boolean) {
+        val choices = listOf(AUTO_QUALITY to "Auto") + presets.map { it.id to it.label }
+        val scheme = MaterialTheme.colorScheme
+        BoxWithConstraints(Modifier.fillMaxWidth()) {
+            val rows = if (compact && maxWidth >= 320.dp * LocalDensity.current.fontScale) {
+                listOf(choices)
+            } else choices.chunked(2)
+            Column(horizontalAlignment = Alignment.CenterHorizontally, verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                Surface(
+                    modifier = Modifier.fillMaxWidth().selectableGroup(),
+                    shape = RoundedCornerShape(12.dp),
+                    color = scheme.surfaceVariant,
+                    border = BorderStroke(1.dp, scheme.outlineVariant),
+                ) {
+                    Column(Modifier.padding(3.dp), verticalArrangement = Arrangement.spacedBy(2.dp)) {
+                        rows.forEach { row ->
+                            Row(horizontalArrangement = Arrangement.spacedBy(2.dp)) {
+                                row.forEach { (id, label) ->
+                                    val checked = selected == id
+                                    Box(
+                                        Modifier.weight(1f).heightIn(min = 48.dp).clip(RoundedCornerShape(9.dp))
+                                            .background(if (checked) RelayBlue else Color.Transparent)
+                                            .selectable(selected = checked, enabled = available, role = Role.RadioButton,
+                                                onClick = { chooseQuality(id) }),
+                                        contentAlignment = Alignment.Center,
+                                    ) {
+                                        Text(label, maxLines = 1, fontWeight = if (checked) FontWeight.SemiBold else FontWeight.Medium,
+                                            color = if (checked) Color.White else scheme.onSurfaceVariant)
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+                if (!compact) {
+                    Text(presets.firstOrNull { it.id == selected }?.detail ?: "Adjusts quality as you watch",
+                        style = MaterialTheme.typography.bodyMedium, color = scheme.onSurfaceVariant,
+                        textAlign = TextAlign.Center)
+                }
+            }
+        }
+    }
+
+    @Composable
+    private fun ManualAddress() {
+        val endpoint = parse(address)
+        val focus = LocalFocusManager.current
+        fun submit() {
+            if (endpoint != null) {
+                focus.clearFocus()
+                connect(endpoint)
+            }
+        }
+        Column(Modifier.fillMaxWidth(), verticalArrangement = Arrangement.spacedBy(8.dp)) {
+            OutlinedTextField(address, { address = it }, label = { Text("Quest IP address") }, singleLine = true,
+                shape = RoundedCornerShape(12.dp), isError = address.isNotBlank() && endpoint == null,
+                keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.Uri, imeAction = ImeAction.Go),
+                keyboardActions = KeyboardActions(onGo = { submit() }), modifier = Modifier.fillMaxWidth())
+            Button(enabled = endpoint != null, onClick = { submit() }, modifier = Modifier.fillMaxWidth(),
+                shape = RoundedCornerShape(12.dp),
+                colors = ButtonDefaults.buttonColors(containerColor = RelayBlue, contentColor = Color.White),
+            ) { Text("Connect") }
+            TextButton(onClick = { showAddress = false }, modifier = Modifier.align(Alignment.CenterHorizontally)) {
+                Text("Cancel")
+            }
+        }
+    }
+
+    private fun chooseQuality(id: String) {
+        if (selected == id || viewModel.state.value is MirrorUiState.Connecting) return
+        selected = id
+        preferences.edit().putString("preset", id).apply()
+        adaptive = AdaptiveQuality()
+        if (viewModel.state.value is MirrorUiState.Connected) viewModel.reconnect()
+    }
+
+    private fun watchQuality() {
+        lifecycleScope.launch {
+            repeatOnLifecycle(Lifecycle.State.RESUMED) {
+                var previous: VideoFrameStats? = null
+                var previousSession: Long? = null
+                while (isActive) {
+                    delay(1000)
+                    val session = viewModel.state.value as? MirrorUiState.Connected
+                    val report = if (selected == AUTO_QUALITY && session != null && hasWindowFocus())
+                        viewModel.liveFrameStats() else null
+                    val last = previous
+                    if (report == null || previousSession != session?.sessionGeneration) {
+                        adaptive.beginStream()
+                    } else if (last != null && adaptive.sample(report.surfaceFrames - last.surfaceFrames,
+                            report.skippedFrames - last.skippedFrames, preset.fps, presets.lastIndex)) {
+                        viewModel.reconnect()
+                    }
+                    previous = report
+                    previousSession = session?.sessionGeneration
+                }
+            }
+        }
+    }
+
+    private fun stopStream() {
+        resumeOnOpen = false
+        search?.cancel()
+        viewModel.disconnect()
+    }
+
+    private fun connect(manual: Address? = null) {
+        if (searching || viewModel.state.value is MirrorUiState.Connecting) return
+        resumeOnOpen = true
+        showAddress = false
+        searchFailed = false
+        searching = true
+        adaptive = AdaptiveQuality()
+        viewModel.disconnect()
+        search = lifecycleScope.launch {
+            try {
+                val serial = preferences.getString("serial", null)
+                val endpoint = manual ?: findService(serial)?.let { resolve(it) }
+                    ?: parse(address)
+                if (endpoint == null) {
+                    searchFailed = true
+                    return@launch
+                }
+                address = "${endpoint.ip}:${endpoint.port}"
+                viewModel.connect(endpoint.ip, endpoint.port, preset.applyTo(playbackSettings)) {
+                    preset.applyTo(playbackSettings)
+                }
+            } finally {
+                searching = false
+                search = null
+            }
+        }
+    }
+
+    private fun parse(value: String): Address? {
+        val parts = value.trim().split(':')
+        if (parts.size !in 1..2) return null
+        val octets = parts[0].split('.').map { it.toIntOrNull() ?: return null }
+        if (octets.size != 4 || octets.any { it !in 0..255 }) return null
+        val privateNetwork = octets[0] == 10 || octets[0] == 172 && octets[1] in 16..31 ||
+            octets[0] == 192 && octets[1] == 168 || octets[0] == 169 && octets[1] == 254
+        if (!privateNetwork) return null
+        val port = if (parts.size == 2) parts[1].toIntOrNull() ?: return null else 5555
+        return if (port in 1..65535) Address(octets.joinToString("."), port) else null
+    }
+
+    private suspend fun findService(serial: String?): NsdServiceInfo? {
+        val nsd = getSystemService(NsdManager::class.java) ?: return null
+        val services = callbackFlow {
+            val listener = object : NsdManager.DiscoveryListener {
+                override fun onDiscoveryStarted(type: String) = Unit
+                override fun onDiscoveryStopped(type: String) { close() }
+                override fun onStopDiscoveryFailed(type: String, code: Int) { close() }
+                override fun onStartDiscoveryFailed(type: String, code: Int) { close() }
+                override fun onServiceLost(info: NsdServiceInfo) { trySend(info to false) }
+                override fun onServiceFound(info: NsdServiceInfo) {
+                    if (info.serviceName.startsWith("adb-") &&
+                        (serial == null || info.serviceName == "adb-$serial")) trySend(info to true)
+                }
+            }
+            runCatching { nsd.discoverServices("_adb._tcp.", NsdManager.PROTOCOL_DNS_SD, listener) }
+                .onFailure { close() }
+            awaitClose { runCatching { nsd.stopServiceDiscovery(listener) } }
+        }
+        if (serial != null) {
+            return withTimeoutOrNull(1600) { services.firstOrNull { it.second }?.first }
+        }
+        // Without a saved serial, only suggest an address if discovery found one service.
+        val candidates = mutableMapOf<String, NsdServiceInfo>()
+        withTimeoutOrNull(1800) {
+            services.collect { (info, found) ->
+                if (found) candidates[info.serviceName] = info else candidates.remove(info.serviceName)
+            }
+        }
+        return candidates.values.singleOrNull()
+    }
+
+    @Suppress("DEPRECATION")
+    private suspend fun resolve(service: NsdServiceInfo): Address? = withTimeoutOrNull(1400) {
+        suspendCancellableCoroutine { continuation ->
+            val nsd = getSystemService(NsdManager::class.java)
+            if (nsd == null) { continuation.resume(null); return@suspendCancellableCoroutine }
+            val completed = AtomicBoolean(false)
+            fun finish(address: Address?) {
+                if (completed.compareAndSet(false, true)) continuation.resume(address)
+            }
+            continuation.invokeOnCancellation { completed.set(true) }
+            runCatching {
+                nsd.resolveService(service, object : NsdManager.ResolveListener {
+                    override fun onResolveFailed(info: NsdServiceInfo, code: Int) = finish(null)
+                    override fun onServiceResolved(info: NsdServiceInfo) {
+                        val ip = (info.host as? Inet4Address)?.hostAddress
+                        finish(ip?.let { parse("$it:${info.port}") })
+                    }
+                })
+            }.onFailure { finish(null) }
+        }
+    }
+}
