diff --git a/app/src/main/java/com/scrcpy/remote/ui/MonoRelayActivity.kt b/app/src/main/java/com/scrcpy/remote/ui/MonoRelayActivity.kt
new file mode 100644
index 0000000..0b84218
--- /dev/null
+++ b/app/src/main/java/com/scrcpy/remote/ui/MonoRelayActivity.kt
@@ -0,0 +1,162 @@
+package com.scrcpy.remote.ui
+
+import android.content.Context
+import android.content.Intent
+import android.net.nsd.NsdManager
+import android.net.nsd.NsdServiceInfo
+import android.os.Bundle
+import androidx.activity.ComponentActivity
+import androidx.activity.compose.setContent
+import androidx.compose.foundation.isSystemInDarkTheme
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxSize
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.foundation.layout.safeDrawingPadding
+import androidx.compose.material3.Button
+import androidx.compose.material3.CircularProgressIndicator
+import androidx.compose.material3.FilterChip
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.OutlinedTextField
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.material3.darkColorScheme
+import androidx.compose.material3.lightColorScheme
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.mutableStateOf
+import androidx.compose.runtime.setValue
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.lifecycleScope
+import java.net.Inet4Address
+import java.util.concurrent.atomic.AtomicBoolean
+import kotlin.coroutines.resume
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.suspendCancellableCoroutine
+import kotlinx.coroutines.withTimeoutOrNull
+import org.json.JSONArray
+
+class MonoRelayActivity : ComponentActivity() {
+    private data class Preset(val id: String, val label: String, val maxSize: Int, val fps: Int, val bitrate: Int)
+    private data class Address(val ip: String, val port: Int)
+
+    private val preferences by lazy { getSharedPreferences("mono_relay", Context.MODE_PRIVATE) }
+    private val presets by lazy {
+        val data = JSONArray(assets.open("stream-presets.json").bufferedReader().use { it.readText() })
+        (0 until data.length()).map { index ->
+            data.getJSONObject(index).let {
+                Preset(it.getString("id"), it.getString("title"), it.getInt("maxSize"),
+                    it.getInt("fps"), it.getInt("bitRateMbps"))
+            }
+        }
+    }
+    private var selected by mutableStateOf("balance")
+    private var address by mutableStateOf("")
+    private var searching by mutableStateOf(false)
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        selected = preferences.getString("preset", "balance") ?: "balance"
+        address = preferences.getString("address", "") ?: ""
+        setContent {
+            MaterialTheme(colorScheme = if (isSystemInDarkTheme()) darkColorScheme() else lightColorScheme()) {
+                Column(
+                    Modifier.fillMaxSize().safeDrawingPadding().padding(24.dp),
+                    verticalArrangement = Arrangement.spacedBy(14.dp),
+                ) {
+                    Text("Трансляция Quest", style = MaterialTheme.typography.headlineSmall)
+                    OutlinedTextField(address, { address = it }, label = { Text("IP Quest") },
+                        placeholder = { Text("192.168.1.42") }, singleLine = true,
+                        enabled = !searching, modifier = Modifier.fillMaxWidth())
+                    Row(horizontalArrangement = Arrangement.spacedBy(6.dp)) {
+                        presets.forEach { item ->
+                            FilterChip(selected = selected == item.id, onClick = {
+                                selected = item.id
+                                preferences.edit().putString("preset", item.id).apply()
+                            }, label = { Text(item.label) }, enabled = !searching)
+                        }
+                    }
+                    if (searching) {
+                        CircularProgressIndicator()
+                        Text("Ищем Quest в локальной сети…")
+                    } else {
+                        Button(onClick = { connect() }, enabled = parse(address) != null) { Text("Подключить") }
+                        TextButton(onClick = {
+                            startActivity(Intent(this@MonoRelayActivity, MainActivity::class.java)
+                                .putExtra(MainActivity.EXTRA_OPEN_PAIRING, true))
+                        }) { Text("Сопряжение ADB…") }
+                    }
+                }
+            }
+        }
+        if (savedInstanceState == null && parse(address) != null) connect(useDiscovery = true)
+    }
+
+    private fun connect(useDiscovery: Boolean = false) {
+        val typed = parse(address) ?: return
+        val preset = presets.firstOrNull { it.id == selected } ?: presets[1]
+        searching = true
+        lifecycleScope.launch {
+            val serial = preferences.getString("serial", null)
+            val target = if (useDiscovery && serial != null) discover(serial) ?: typed else typed
+            address = "${target.ip}:${target.port}"
+            val options = "maxSize=${preset.maxSize}&bitrate=${preset.bitrate}&fps=${preset.fps}&audio=playback&audioDup=true"
+            startActivity(MirrorActivity.newIntent(this@MonoRelayActivity, target.ip, target.port, linkOptions = options))
+            searching = false
+        }
+    }
+
+    private fun parse(value: String): Address? {
+        val parts = value.trim().split(':')
+        if (parts.size !in 1..2) return null
+        val octets = parts[0].split('.').map { it.toIntOrNull() ?: return null }
+        if (octets.size != 4 || octets.any { it !in 0..255 }) return null
+        val privateNetwork = octets[0] == 10 || octets[0] == 172 && octets[1] in 16..31 ||
+            octets[0] == 192 && octets[1] == 168 || octets[0] == 169 && octets[1] == 254
+        if (!privateNetwork) return null
+        val port = if (parts.size == 2) parts[1].toIntOrNull() ?: return null else 5555
+        return if (port in 1..65535) Address(octets.joinToString("."), port) else null
+    }
+
+    @Suppress("DEPRECATION")
+    private suspend fun discover(serial: String): Address? = withTimeoutOrNull(1600) {
+        suspendCancellableCoroutine { continuation ->
+            val nsd = getSystemService(NsdManager::class.java)
+            if (nsd == null) { continuation.resume(null); return@suspendCancellableCoroutine }
+            val completed = AtomicBoolean(false)
+            val resolving = AtomicBoolean(false)
+            val listener = object : NsdManager.DiscoveryListener {
+                override fun onDiscoveryStarted(type: String) = Unit
+                override fun onDiscoveryStopped(type: String) = Unit
+                override fun onStopDiscoveryFailed(type: String, code: Int) = Unit
+                override fun onServiceLost(info: NsdServiceInfo) = Unit
+                override fun onStartDiscoveryFailed(type: String, code: Int) = finish(null)
+                override fun onServiceFound(info: NsdServiceInfo) {
+                    if (info.serviceName != "adb-$serial" || !resolving.compareAndSet(false, true)) return
+                    runCatching {
+                        nsd.resolveService(info, object : NsdManager.ResolveListener {
+                            override fun onResolveFailed(info: NsdServiceInfo, code: Int) = finish(null)
+                            override fun onServiceResolved(info: NsdServiceInfo) {
+                                val ip = (info.host as? Inet4Address)?.hostAddress
+                                finish(ip?.let { parse("$it:${info.port}") })
+                            }
+                        })
+                    }.onFailure { finish(null) }
+                }
+
+                fun finish(found: Address?) {
+                    if (!completed.compareAndSet(false, true)) return
+                    runCatching { nsd.stopServiceDiscovery(this) }
+                    continuation.resume(found)
+                }
+            }
+            continuation.invokeOnCancellation {
+                if (completed.compareAndSet(false, true)) runCatching { nsd.stopServiceDiscovery(listener) }
+            }
+            runCatching { nsd.discoverServices("_adb._tcp.", NsdManager.PROTOCOL_DNS_SD, listener) }
+                .onFailure { listener.finish(null) }
+        }
+    }
+}
