@@ -0,0 +1,66 @@
+package com.scrcpy.remote.ui
+
+import android.content.Context
+import com.scrcpy.remote.data.MirrorSettings
+import org.json.JSONArray
+
+internal const val AUTO_QUALITY = "auto"
+
+internal data class MonoRelayPreset(
+    val id: String,
+    val label: String,
+    val maxSize: Int,
+    val fps: Int,
+    val bitrate: Int,
+    val audioBufferMs: Int,
+) {
+    val detail get() = "$maxSize px · до $fps FPS · $bitrate Мбит/с"
+
+    fun applyTo(settings: MirrorSettings): MirrorSettings = settings.copy(
+        maxSize = maxSize,
+        maxFps = fps,
+        videoBitRateMbps = bitrate,
+        audioBufferMs = audioBufferMs,
+    )
+
+    companion object {
+        fun read(context: Context): List<MonoRelayPreset> {
+            val data = JSONArray(context.assets.open("stream-presets.json").bufferedReader().use { it.readText() })
+            return (0 until data.length()).map { index ->
+                val item = data.getJSONObject(index)
+                MonoRelayPreset(item.getString("id"), item.getString("title"), item.getInt("maxSize"),
+                    item.getInt("fps"), item.getInt("bitRateMbps"), item.getInt("audioBufferMs"))
+            }
+        }
+    }
+}
+
+internal class AdaptiveQuality {
+    var index = 1
+        private set
+    private var warmup = 3
+    private var strained = 0
+    private var stable = 0
+    private var mayRaise = true
+
+    fun beginStream() {
+        warmup = 3
+        strained = 0
+        stable = 0
+    }
+
+    fun sample(rendered: Long, skipped: Long, cap: Int, lastIndex: Int): Boolean {
+        if (warmup > 0) {
+            warmup--
+            return false
+        }
+        strained = if (skipped >= 3 && skipped * 5 >= rendered + skipped) strained + 1 else 0
+        stable = if (mayRaise && skipped == 0L && rendered * 4 >= cap * 3) stable + 1 else 0
+        if (index > 0 && strained >= 4) index--
+        else if (index < lastIndex && stable >= 45) index++
+        else return false
+        mayRaise = false
+        beginStream()
+        return true
+    }
+}
